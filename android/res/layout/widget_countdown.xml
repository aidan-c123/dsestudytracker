<?xml version="1.0" encoding="utf-8"?>
<!--
  Countdown widget.

  One figure, read at a glance: the days remaining. The date sits under it, and
  results under that. The footer says when the figures were last synced, because
  a widget cannot refresh itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_countdown_title"
        android:textColor="#6B7770"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#10574B"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_days_unit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="5dp"
            android:layout_gravity="bottom"
            android:text="@string/widget_days_to_go"
            android:textColor="#6B7770"
            android:textSize="11sp"
            android:maxLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_exam_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#141A17"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#6B7770"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_saved"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:textColor="#98A29C"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
