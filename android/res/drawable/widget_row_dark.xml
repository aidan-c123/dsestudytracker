<?xml version="1.0" encoding="utf-8"?>
<!-- A dark-theme row: quiet by default, pressed shows the accent wash. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#172A23" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151B18" />
            <stroke android:width="1dp" android:color="#26302B" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
