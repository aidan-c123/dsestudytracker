<?xml version="1.0" encoding="utf-8"?>
<!-- A quick-log row: quiet by default, pressed shows the accent wash. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8F0ED" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F6F1" />
            <stroke android:width="1dp" android:color="#E6E2D8" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
